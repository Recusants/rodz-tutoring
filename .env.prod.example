# Production Environment Configuration
SECRET_KEY=generate-a-strong-random-50-character-secret-key-for-prod
DEBUG=False
ALLOWED_HOSTS=yourdomain.co.za,www.yourdomain.co.za,127.0.0.1,localhost,your-aws-ec2-ip

# Port exposed on AWS Host (default 80 for direct web traffic)
HOST_PORT=80

# WhatsApp & Platform Contact Settings
WHATSAPP_PHONE=27745685212
WHATSAPP_DISPLAY_PHONE=+27 74 568 5212
INFO_EMAIL=info@rodztutoring.co.za

# Docker Hub Registry & Image Tag
DOCKER_REGISTRY=yourdockerhubusername
TAG=latest

# Database, Auto-Seeding & Workers
SQLITE_PATH=/app/data/db.sqlite3
AUTO_SEED=True
GUNICORN_WORKERS=0
